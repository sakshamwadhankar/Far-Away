{
  "name": "komvos",
  "version": "0.1.0",
  "description": "Komvos desktop application — Electron + React + TypeScript + React Flow",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.komvos.app",
    "productName": "Komvos",
    "directories": {
      "output": "../dist"
    },
    "extraResources": [
      {
        "from": "../../packaging/dist",
        "to": "backend",
        "filter": ["komvos_backend.exe", "komvos_backend"]
      }
    ],
    "mac": {
      "target": ["dmg"],
      "identity": null
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "author": {
    "name": "NeuralFlow Team",
    "email": "team@neuralflow.com"
  },
  "homepage": "https://github.com/sakshamwadhankar/Far-Away",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakshamwadhankar/Far-Away.git"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
