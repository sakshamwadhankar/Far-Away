{
  "schema_version": "2.0",
  "id": "e931b204-c5a1-4328-9844-4821d3f99012",
  "name": "Desktop Automation Demo",
  "version": "1.0.0",
  "endpoints": {
    "google:gemini-3.6-flash": {
      "kind": "google",
      "model": "gemini-3.6-flash"
    }
  },
  "nodes": [
    {
      "id": "in",
      "type": "input",
      "inputs": [],
      "outputs": [
        {
          "name": "task",
          "type": "text"
        }
      ]
    },
    {
      "id": "policy_boundary",
      "type": "access",
      "config": {
        "access_policy": {
          "providers": [
            "google",
            "openai"
          ],
          "allow_local_models": true,
          "allow_network": true,
          "allowed_domains": [
            "generativelanguage.googleapis.com"
          ],
          "allow_desktop": true,
          "allowed_applications": [
            "Komvos",
            "Start",
            "Search",
            "Google Chrome",
            "Chrome",
            "Settings",
            "Calculator",
            "Notepad",
            "Visual Studio Code"
          ],
          "allow_destructive": false
        }
      },
      "inputs": [],
      "outputs": []
    },
    {
      "id": "computer_agent",
      "type": "computer",
      "endpoint_ref": "google:gemini-3.6-flash",
      "config": {
        "system_prompt": "You are an autonomous desktop assistant using screen vision."
      },
      "inputs": [
        {
          "name": "task",
          "type": "text"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "text"
        },
        {
          "name": "last_screenshot",
          "type": "image"
        }
      ]
    },
    {
      "id": "out",
      "type": "output",
      "inputs": [
        {
          "name": "result",
          "type": "text"
        },
        {
          "name": "screenshot",
          "type": "image"
        }
      ],
      "outputs": []
    }
  ],
  "edges": [
    {
      "from": "in.task",
      "to": "computer_agent.task"
    },
    {
      "from": "policy_boundary.scope",
      "to": "computer_agent.task"
    },
    {
      "from": "computer_agent.result",
      "to": "out.result"
    },
    {
      "from": "computer_agent.last_screenshot",
      "to": "out.screenshot"
    }
  ]
}
